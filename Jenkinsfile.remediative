pipeline {
    agent any

    environment {
        ARM_SUBSCRIPTION_ID = credentials('AZURE_SUBSCRIPTION_ID')
        AZURE_CLIENT_ID     = credentials('AZURE_CLIENT_ID')
        AZURE_CLIENT_SECRET = credentials('AZURE_CLIENT_SECRET')
        AZURE_TENANT_ID     = credentials('AZURE_TENANT_ID')
        TEAMS_WEBHOOK_URL   = credentials('TEAMS_WEBHOOK_URL')
        PYTHON_EXE          = 'C:/Users/admin/AppData/Local/Programs/Python/Python312/python.exe'
        TFSEC_EXE           = '"C:/Program Files/tfsec/tfsec.exe"'
        OPA_EXE             = '"C:/Program Files/OPA/opa.exe"'
    }

    stages {

        // ---------------------------------------------------------------
        // Pull the latest IaC source and prepare a clean outputs/ folder.
        // ---------------------------------------------------------------
        stage('Checkout Code') {
            steps {
                checkout scm
                bat '''
                if not exist outputs mkdir outputs
                del /f /q outputs\\*.json 2>nul
                del /f /q outputs\\*.bat  2>nul
                echo [Init] Workspace ready.
                '''
            }
        }

        // ---------------------------------------------------------------
        // Authenticate to Azure once. All subsequent az calls (including
        // those made by Python scripts via subprocess) reuse this session.
        // ---------------------------------------------------------------
        stage('Environment Setup') {
            steps {
                bat '''
                @echo off
                echo [Auth] Authenticating to Azure...
                call az login --service-principal ^
                    -u "%AZURE_CLIENT_ID%" ^
                    -p "%AZURE_CLIENT_SECRET%" ^
                    --tenant "%AZURE_TENANT_ID%"
                call az account set --subscription "%ARM_SUBSCRIPTION_ID%"
                echo [Auth] Active subscription:
                call az account show --query "{name:name, id:id}" --output table
                echo [Auth] Login successful.
                '''
            }
        }

        // ---------------------------------------------------------------
        // query_azure.py fires all four Azure Resource Graph queries and
        // saves raw results to outputs/*_raw.json.  These files feed the
        // Audit Engine in the next stage so no query is run twice.
        //
        //   outputs/nsg_raw.json     — NSG inbound rules
        //   outputs/storage_raw.json — Storage accounts (HTTPS / public blob)
        //   outputs/scaling_raw.json — VM hardware profiles
        //   outputs/iam_raw.json     — Role assignments + activity log (24 h)
        // ---------------------------------------------------------------
        stage('Query Azure Resource Graph') {
            steps {
                bat '"%PYTHON_EXE%" scripts/query_azure.py'
                archiveArtifacts artifacts: 'outputs/*_raw.json',
                                 allowEmptyArchive: true
            }
        }

        // ---------------------------------------------------------------
        // Each detect_*.py script reads its pre-queried *_raw.json, maps
        // findings to CIS Azure Benchmark controls, and writes:
        //   outputs/<scenario>_drift.json   — structured violation list
        //
        // generate_dashboard.py aggregates all four into a compliance score.
        // The pre-remediation snapshot captures the environment "at its worst"
        // for the Scenario 5 compliance lifecycle demo.
        //
        //   CIS 6.1 / 6.2  — NSG open SSH/RDP (Scenario 1)
        //   CIS 3.15 / 3.5 — Storage HTTPS + public blob (Scenario 2)
        //   Cost Governance — VM size vs IaC baseline (Scenario 3)
        //   CIS 1.1         — Unauthorized high-privilege roles (Scenario 4)
        // ---------------------------------------------------------------
        stage('Execute Python Audit Engine (CIS Mapping)') {
            steps {
                // -- Scenario 1-4 drift detection --
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_nsg_drift.py')
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_storage_drift.py')
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_scaling_drift.py')
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_iam_drift.py')

                // -- CIS Azure Benchmark (moved from preventive Layer B) ----
                // Run tfsec against the checked-out Terraform code to produce
                // a fresh tfsec_results.json, then evaluate it with OPA and
                // cis_azure.rego. This wires static CIS control checks into the
                // remediative audit cycle so live infra and IaC drift are both covered.
                bat(returnStatus: true,
                    script: "${env.TFSEC_EXE} terraform --format json --include-passed > outputs/tfsec_scan.json")
                script {
                    def result = bat(
                        script: """@echo off
${env.OPA_EXE} eval -i outputs/tfsec_scan.json -d policies/cis_azure.rego "data.cis.azure.deny" --format pretty""",
                        returnStdout: true
                    ).trim()
                    echo "--- CIS Azure Benchmark (OPA) ---\n${result}"
                    def hasViolation = result.contains('VIOLATION')
                    def violationLines = result.split('\n').findAll { it.trim().contains('VIOLATION') }
                    writeFile file: 'outputs/opa_cis_result.json', text: groovy.json.JsonOutput.prettyPrint(
                        groovy.json.JsonOutput.toJson([
                            check      : 'CIS Azure Benchmark',
                            policy     : 'policies/cis_azure.rego',
                            input      : 'outputs/tfsec_scan.json',
                            status     : hasViolation ? 'FAILED' : 'PASSED',
                            violations : violationLines,
                            raw_output : result
                        ])
                    )
                    if (hasViolation) {
                        unstable("OPA CIS: Benchmark violations found — see outputs/opa_cis_result.json")
                    }
                }

                bat '"%PYTHON_EXE%" scripts/generate_dashboard.py pre_remediation'
                script {
                    def dash = readFile('outputs/compliance_dashboard_latest.json')
                    echo "============================================"
                    echo " PRE-REMEDIATION COMPLIANCE SNAPSHOT"
                    echo "============================================"
                    ['nsg_drift', 'storage_drift', 'scaling_drift', 'iam_drift'].each { f ->
                        if (fileExists("outputs/${f}.json")) {
                            def content = readFile("outputs/${f}.json")
                            def drifted = content.contains('"drifted": true')
                            echo " ${f.replace('_drift','').toUpperCase().padRight(10)} : ${drifted ? 'DRIFTED' : 'COMPLIANT'}"
                        }
                    }
                    echo "============================================"
                }
                archiveArtifacts artifacts: 'outputs/*_drift.json, outputs/compliance_dashboard_pre_remediation.json',
                                 allowEmptyArchive: true
            }
        }

        // ---------------------------------------------------------------
        // Display and archive the remediation scripts generated by the
        // Audit Engine. Operators can review exactly what will be executed
        // before any self-healing runs.
        // ---------------------------------------------------------------
        stage('Generate Remediation Scripts') {
            steps {
                script {
                    echo "============================================"
                    echo " GENERATED REMEDIATION SCRIPTS"
                    echo "============================================"
                    [
                        [file: 'outputs/nsg_remediate.bat',     label: 'Scenario 1 — NSG Self-Healing (CIS 6.1/6.2)'],
                        [file: 'outputs/storage_remediate.bat', label: 'Scenario 2 — Storage HTTPS Fix (CIS 3.15)'],
                        [file: 'outputs/scaling_remediate.bat', label: 'Scenario 3 — VM Baseline Revert (Cost Governance)'],
                        [file: 'outputs/iam_remediate.bat',     label: 'Scenario 4 — IAM Role Removal (CIS 1.1)']
                    ].each { s ->
                        if (fileExists(s.file)) {
                            echo "\n--- ${s.label} ---"
                            bat "type ${s.file}"
                        } else {
                            echo "\n--- ${s.label} --- (no drift detected, script not generated)"
                        }
                    }
                    echo "============================================"
                }
                archiveArtifacts artifacts: 'outputs/*.bat, outputs/*.json',
                                 allowEmptyArchive: true
            }
        }

        // ---------------------------------------------------------------
        // Execute the appropriate action for each scenario:
        //
        //  Scenario 1 – NSG        : Automatic self-healing (close port).
        //  Scenario 2 – Storage    : Manual approval gate in Jenkins UI.
        //  Scenario 3 – Scaling    : Notify DevOps, mark build UNSTABLE.
        //  Scenario 4 – IAM        : Alert security team, mark UNSTABLE.
        //
        // After remediation, all detectors re-run and the post-remediation
        // dashboard shows the recovered compliance percentage (Scenario 5).
        // A Teams card is sent with before/after compliance scores.
        // ---------------------------------------------------------------
        stage('Trigger Self-Healing & Alerts') {
            steps {

                // -- Scenario 1: Auto-Fix NSG open ports ------------------
                script {
                    if (fileExists('outputs/nsg_drift.json') &&
                        readFile('outputs/nsg_drift.json').contains('"drifted": true')) {
                        echo "=== [Scenario 1] Rogue Admin — Self-Healing: closing open NSG ports ==="
                        bat '''
                        echo --- NSG Remediation Preview ---
                        type outputs\\nsg_remediate.bat
                        echo --------------------------------
                        call outputs\\nsg_remediate.bat
                        '''
                        echo "=== [Scenario 1] NSG self-healing complete ==="
                    } else {
                        echo "[Scenario 1] NSG: COMPLIANT — no open ports found."
                    }
                }

                // -- Scenario 2: Manual Approval for Storage fix ----------
                script {
                    if (fileExists('outputs/storage_drift.json') &&
                        readFile('outputs/storage_drift.json').contains('"drifted": true')) {
                        echo "=== [Scenario 2] Data Exfiltration Risk — HTTPS drift detected ==="
                        bat 'type outputs\\storage_drift.json'
                        def approved = false
                        try {
                            timeout(time: 30, unit: 'MINUTES') {
                                input(
                                    message: 'Storage account(s) have insecure settings. Apply the remediation script?',
                                    ok: 'Approve & Apply',
                                    parameters: [
                                        text(name: 'APPROVER_NOTE',
                                             defaultValue: '',
                                             description: 'Reason for approval (optional)')
                                    ]
                                )
                            }
                            approved = true
                        } catch (err) {
                            echo "Approval timed out or was rejected — storage drift persists until next run."
                        }
                        if (approved) {
                            bat '''
                            echo --- Storage Remediation ---
                            call outputs\\storage_remediate.bat
                            '''
                            echo "=== [Scenario 2] Storage HTTPS fix applied ==="
                        }
                    } else {
                        echo "[Scenario 2] Storage: COMPLIANT — all accounts use HTTPS-only."
                    }
                }

                // -- Scenario 3: Cost drift notification ------------------
                script {
                    if (fileExists('outputs/scaling_drift.json') &&
                        readFile('outputs/scaling_drift.json').contains('"drifted": true')) {
                        echo "=== [Scenario 3] Cost Control — VM(s) scaled beyond IaC baseline ==="
                        bat 'type outputs\\scaling_drift.json'
                        echo "Revert script generated at outputs/scaling_remediate.bat — requires DevOps approval."
                        unstable("Cost drift: VM(s) outside IaC baseline — DevOps review required.")
                    } else {
                        echo "[Scenario 3] Scaling: COMPLIANT — all VMs within approved sizes."
                    }
                }

                // -- Scenario 4: IAM privilege escalation alert -----------
                script {
                    if (fileExists('outputs/iam_drift.json') &&
                        readFile('outputs/iam_drift.json').contains('"drifted": true')) {
                        echo "=== [Scenario 4] CRITICAL — Unauthorized IAM role assignment detected ==="
                        bat 'type outputs\\iam_drift.json'
                        echo "Role removal script generated at outputs/iam_remediate.bat — requires security team sign-off."
                        unstable("IAM privilege escalation detected — security team alerted.")
                    } else {
                        echo "[Scenario 4] IAM: COMPLIANT — no unauthorized assignments found."
                    }
                }

                // -- Post-remediation verification ------------------------
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_nsg_drift.py')
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_storage_drift.py')
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_scaling_drift.py')
                bat(returnStatus: true, script: '"%PYTHON_EXE%" scripts/detect_iam_drift.py')
                bat '"%PYTHON_EXE%" scripts/generate_dashboard.py post_remediation'
                archiveArtifacts artifacts: 'outputs/compliance_dashboard_post_remediation.json',
                                 allowEmptyArchive: true

                // -- Scenario 5: Teams notification with before/after -----
                script {
                    def buildResult = currentBuild.currentResult
                    def blockingText = fileExists('outputs/nsg_drift.json')     ? readFile('outputs/nsg_drift.json').trim()     : ''
                    def iamText      = fileExists('outputs/iam_drift.json')     ? readFile('outputs/iam_drift.json').trim()     : ''
                    def scalingText  = fileExists('outputs/scaling_drift.json') ? readFile('outputs/scaling_drift.json').trim() : ''

                    def themeColor  = (buildResult == 'SUCCESS')  ? '00CC44' :
                                      (buildResult == 'UNSTABLE') ? 'FFA500' : 'CC0000'
                    def statusLabel = (buildResult == 'SUCCESS')  ? 'All scenarios remediated — environment compliant' :
                                      (buildResult == 'UNSTABLE') ? 'Partial remediation — manual review required' :
                                                                    'Pipeline error — review logs'

                    def body = "<b>Build:</b> ${env.JOB_NAME} #${env.BUILD_NUMBER}<br><br>" +
                               "<b>Scenarios:</b><br>" +
                               "• [1] NSG Open Ports — auto self-healing applied<br>" +
                               "• [2] Storage HTTPS  — manual approval gate<br>" +
                               "• [3] VM Scaling     — DevOps notified, revert script ready<br>" +
                               "• [4] IAM Tampering  — security team alerted, removal script ready<br><br>" +
                               "See build artifacts for full drift JSON, remediation scripts, and dashboard snapshots."

                    def payload = groovy.json.JsonOutput.toJson([
                        "@type"     : "MessageCard",
                        "@context"  : "http://schema.org/extensions",
                        "themeColor": themeColor,
                        "summary"   : "CSPM Remediation — ${statusLabel}",
                        "sections"  : [[
                            "activityTitle"   : statusLabel,
                            "activitySubtitle": "${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            "activityText"    : body,
                            "markdown"        : true
                        ]]
                    ])
                    writeFile file: 'outputs/teams_payload.json', text: payload
                    bat(returnStatus: true,
                        script: 'curl -s -X POST -H "Content-Type: application/json" -d @outputs\\teams_payload.json %TEAMS_WEBHOOK_URL%')
                }
            }
        }
    }

    post {
        success {
            echo "All detected drift was remediated. Environment is fully compliant."
        }
        unstable {
            echo "Partial remediation complete. Items flagged UNSTABLE require manual review — see build artifacts."
        }
        failure {
            echo "Pipeline error — review stage logs. No changes may have been applied."
        }
        always {
            echo "Artifacts saved to outputs/. See compliance_dashboard_*.json for before/after compliance scores."
        }
    }
}
