// =============================================================================
// CSPM Dashboard Pipeline
// Reads every JSON artifact in outputs/ and generates a self-contained HTML
// dashboard (outputs/dashboard.html) with interactive charts and tables.
//
// Run this pipeline AFTER Jenkinsfile.preventive and/or Jenkinsfile.remediative
// have produced JSON files in the shared workspace, or point this pipeline at
// the same Jenkins workspace via a shared agent label / persistent workspace.
// =============================================================================

pipeline {
    agent any

    environment {
        PYTHON_EXE = 'C:/Users/admin/AppData/Local/Programs/Python/Python312/python.exe'
    }

    stages {

        // -----------------------------------------------------------------------
        // Pull the latest pipeline code so generate_ui.py is always current.
        // JSON outputs from the preventive / remediative pipelines are left
        // intact; only a stale dashboard.html is removed.
        // -----------------------------------------------------------------------
        stage('Checkout & Prepare') {
            steps {
                checkout scm
                bat '''
                @echo off
                if not exist outputs mkdir outputs
                del /f /q outputs\\dashboard.html 2>nul
                echo [Dashboard] Workspace ready.
                '''
            }
        }

        // -----------------------------------------------------------------------
        // List whatever JSON files are present so the build log is transparent.
        // -----------------------------------------------------------------------
        stage('Inspect Outputs') {
            steps {
                bat '''
                @echo off
                echo ========================================
                echo  JSON artifacts found in outputs/
                echo ========================================
<<<<<<< HEAD
                pwd
                dir /b outputs\\*.json 2>nul || echo (no JSON files found — dashboard will show placeholders)
=======
                dir /b "C:/ProgramData/Jenkins/.jenkins/workspace/Bharath_C1_Pipeline1/outputs\\*.json 2>nul || echo (no JSON files found — dashboard will show placeholders)
>>>>>>> acbf73afa2ed0bd3d857bd3705567bf18922af68
                echo ========================================
                '''
            }
        }

        // -----------------------------------------------------------------------
        // Run generate_ui.py. Reads every supported JSON from outputs/ and
        // writes outputs/dashboard.html — a fully self-contained file with
        // Chart.js charts and filterable tables.  Missing JSON files are
        // handled gracefully by the script (sections show placeholder text).
        // -----------------------------------------------------------------------
        stage('Generate HTML Dashboard') {
            steps {
                bat '"%PYTHON_EXE%" scripts/generate_ui.py'
            }
        }

        // -----------------------------------------------------------------------
        // Publish via the Jenkins HTML Publisher plugin so the dashboard is
        // accessible directly from the build page sidebar.
        // Requires: HTML Publisher Plugin (manage plugins → install if missing).
        // -----------------------------------------------------------------------
        stage('Publish Dashboard') {
            steps {
                publishHTML(target: [
                    reportName           : 'Dashboard UI',
                    reportDir            : 'outputs',
                    reportFiles          : 'dashboard.html',
                    keepAll              : true,
                    alwaysLinkToLastBuild: true,
                    allowMissing         : false
                ])
                echo "[Dashboard] Published — click 'Dashboard UI' in the build sidebar to view."
            }
        }

        // -----------------------------------------------------------------------
        // Archive the HTML and all source JSON files for audit trails.
        // -----------------------------------------------------------------------
        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'outputs/dashboard.html, outputs/**/*.json',
                                 allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            echo "Dashboard generated successfully. Open 'Dashboard UI' in the build sidebar."
        }
        unstable {
            echo "Dashboard generated with warnings. Review the stage logs above."
        }
        failure {
            echo "Dashboard generation failed. Verify Python is at %PYTHON_EXE% and scripts/generate_ui.py exists."
        }
        always {
            echo "Artifact: outputs/dashboard.html"
        }
    }
}
