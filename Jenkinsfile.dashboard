// =============================================================================
// CSPM Dashboard Pipeline
// Copies JSON artifacts from Pipeline1 / Pipeline2 into dashboard/public/outputs/,
// builds the Vite + React app in dashboard/, then publishes dashboard/dist/ via
// the Jenkins HTML Publisher plugin.
// =============================================================================

pipeline {
    agent any

    environment {
        NODE_HOME = 'C:\\Program Files\\nodejs'
        PATH      = "${NODE_HOME};${env.PATH}"
    }

    stages {

        // -----------------------------------------------------------------------
        // Check out the latest source so the React app code is always current.
        // -----------------------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // -----------------------------------------------------------------------
        // Copy JSON artifacts from both upstream pipeline workspaces into
        // dashboard/public/outputs/ so the React app can fetch them at runtime.
        // -----------------------------------------------------------------------
        stage('Collect JSON Outputs') {
            steps {
                bat '''
                @echo off
                set DST=%CD%\\dashboard\\public\\outputs
                if not exist "%DST%" mkdir "%DST%"

                set SRC1=C:\\ProgramData\\Jenkins\\.jenkins\\workspace\\Bharath_C1_Pipeline1\\outputs
                if exist "%SRC1%" (
                    echo [Collect] Copying from Pipeline1: %SRC1%
                    xcopy /Y /D "%SRC1%\\*.json" "%DST%\\" 2>nul
                ) else (
                    echo [Collect] Pipeline1 outputs not found: %SRC1% -- skipping.
                )

                set SRC2=C:\\ProgramData\\Jenkins\\.jenkins\\workspace\\Bharath_C1_Pipeline2\\outputs
                if exist "%SRC2%" (
                    echo [Collect] Copying from Pipeline2: %SRC2%
                    xcopy /Y /D "%SRC2%\\*.json" "%DST%\\" 2>nul
                ) else (
                    echo [Collect] Pipeline2 outputs not found: %SRC2% -- skipping.
                )

                echo [Collect] JSON files staged in %DST%:
                dir /b "%DST%\\*.json" 2>nul || echo (none found)
                '''
            }
        }

        // -----------------------------------------------------------------------
        // Install npm dependencies inside the dashboard folder.
        // Deletes any stale node_modules first to avoid picking up packages
        // installed at a different path (e.g. a prior json-parser workspace).
        // Uses npm.cmd so Windows bat resolves it without relying on PATH shims.
        // -----------------------------------------------------------------------
        stage('Install Dependencies') {
            steps {
                bat '''
                @echo off
                echo [Node] Version check:
                "%NODE_HOME%\\node.exe" --version
                "%NODE_HOME%\\npm.cmd"  --version

                echo [NPM] Cleaning stale node_modules...
                if exist "dashboard\\node_modules" rmdir /s /q "dashboard\\node_modules"

                echo [NPM] Installing dependencies...
                "%NODE_HOME%\\npm.cmd" install --prefix dashboard
                '''
            }
        }

        // -----------------------------------------------------------------------
        // Build the production bundle. Vite writes the output to dashboard/dist/.
        // -----------------------------------------------------------------------
        stage('Build React App') {
            steps {
                bat '"%NODE_HOME%\\npm.cmd" run build --prefix dashboard'
            }
        }

        // -----------------------------------------------------------------------
        // Relax Jenkins' default CSP so the React app's JS/CSS loads correctly
        // when served from Build Artifacts. Without this every artifact page
        // blocks all scripts and the dashboard renders blank.
        // -----------------------------------------------------------------------
        stage('Relax CSP') {
            steps {
                script {
                    System.setProperty(
                        'hudson.model.DirectoryBrowserSupport.CSP',
                        "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;"
                    )
                    echo "[CSP] Content-Security-Policy relaxed for artifact serving."
                }
            }
        }

        // -----------------------------------------------------------------------
        // Try to publish via HTML Publisher plugin (sidebar link).
        // If the plugin is not installed the catchError keeps the build GREEN
        // and the archive step below still saves the dist/ folder.
        // To install: Manage Jenkins → Plugins → search "HTML Publisher".
        // -----------------------------------------------------------------------
        stage('Publish Dashboard') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    publishHTML(target: [
                        reportName           : 'Dashboard UI',
                        reportDir            : 'dashboard/dist',
                        reportFiles          : 'index.html',
                        keepAll              : true,
                        alwaysLinkToLastBuild: true,
                        allowMissing         : false
                    ])
                }
                echo "[Dashboard] Build complete — dashboard/dist/index.html is ready."
            }
        }

        // -----------------------------------------------------------------------
        // Archive the full dist/ folder so the dashboard is always accessible
        // via Build Artifacts → dashboard/dist/index.html, even without the
        // HTML Publisher plugin.
        // -----------------------------------------------------------------------
        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'dashboard/dist/**,dashboard/public/outputs/*.json',
                                 allowEmptyArchive: true
                echo "[Archive] Open: Build Artifacts → dashboard/dist/index.html"
            }
        }
    }

    post {
        success {
            echo "React dashboard built and published. Open 'Dashboard UI' in the build sidebar."
        }
        unstable {
            echo "Build finished with warnings. Check stage logs above."
        }
        failure {
            echo "Build failed. Ensure Node.js is installed and accessible on the PATH."
        }
        always {
            echo "Build artifact: dashboard/dist/index.html"
        }
    }
}
