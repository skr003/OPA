// =============================================================================
// CSPM Dashboard Pipeline
// Copies JSON artifacts from Pipeline1 / Pipeline2 into dashboard/public/outputs/,
// builds the Vite + React app in dashboard/, then publishes dashboard/dist/ via
// the Jenkins HTML Publisher plugin.
// =============================================================================

pipeline {
    agent any

    stages {

        // -----------------------------------------------------------------------
        // Check out the latest source so the React app code is always current.
        // -----------------------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // -----------------------------------------------------------------------
        // Copy JSON artifacts from both upstream pipeline workspaces into
        // dashboard/public/outputs/ so the React app can fetch them at runtime.
        // -----------------------------------------------------------------------
        stage('Collect JSON Outputs') {
            steps {
                bat '''
                @echo off
                set DST=%CD%\\dashboard\\public\\outputs
                if not exist "%DST%" mkdir "%DST%"

                set SRC1=C:\\ProgramData\\Jenkins\\.jenkins\\workspace\\Bharath_C1_Pipeline1\\outputs
                if exist "%SRC1%" (
                    echo [Collect] Copying from Pipeline1: %SRC1%
                    xcopy /Y /D "%SRC1%\\*.json" "%DST%\\" 2>nul
                ) else (
                    echo [Collect] Pipeline1 outputs not found: %SRC1% -- skipping.
                )

                set SRC2=C:\\ProgramData\\Jenkins\\.jenkins\\workspace\\Bharath_C1_Pipeline2\\outputs
                if exist "%SRC2%" (
                    echo [Collect] Copying from Pipeline2: %SRC2%
                    xcopy /Y /D "%SRC2%\\*.json" "%DST%\\" 2>nul
                ) else (
                    echo [Collect] Pipeline2 outputs not found: %SRC2% -- skipping.
                )

                echo [Collect] JSON files staged in %DST%:
                dir /b "%DST%\\*.json" 2>nul || echo (none found)
                '''
            }
        }

        // -----------------------------------------------------------------------
        // Install npm dependencies inside the dashboard folder.
        // node_modules is not committed, so this must run every build.
        // -----------------------------------------------------------------------
        stage('Install Dependencies') {
            steps {
                dir('dashboard') {
                    bat 'npm install'
                }
            }
        }

        // -----------------------------------------------------------------------
        // Build the production bundle. Vite writes the output to dashboard/dist/.
        // -----------------------------------------------------------------------
        stage('Build React App') {
            steps {
                dir('dashboard') {
                    bat 'npm run build'
                }
            }
        }

        // -----------------------------------------------------------------------
        // Publish dashboard/dist/ via the HTML Publisher plugin.
        // The entry point is index.html produced by the Vite build.
        // Requires: HTML Publisher Plugin (Manage Plugins → install if missing).
        // -----------------------------------------------------------------------
        stage('Publish Dashboard') {
            steps {
                publishHTML(target: [
                    reportName           : 'Dashboard UI',
                    reportDir            : 'dashboard/dist',
                    reportFiles          : 'index.html',
                    keepAll              : true,
                    alwaysLinkToLastBuild: true,
                    allowMissing         : false
                ])
                echo "[Dashboard] Published — click 'Dashboard UI' in the build sidebar."
            }
        }

        // -----------------------------------------------------------------------
        // Archive the built dist/ folder and the collected JSON files.
        // -----------------------------------------------------------------------
        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'dashboard/dist/**,dashboard/public/outputs/*.json',
                                 allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            echo "React dashboard built and published. Open 'Dashboard UI' in the build sidebar."
        }
        unstable {
            echo "Build finished with warnings. Check stage logs above."
        }
        failure {
            echo "Build failed. Ensure Node.js is installed and accessible on the PATH."
        }
        always {
            echo "Build artifact: dashboard/dist/index.html"
        }
    }
}
