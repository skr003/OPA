pipeline {
    agent any

    environment {
        TFSEC_EXE   = '"C:/Program Files/tfsec/tfsec.exe"'
        OPA_EXE     = '"C:/Program Files/OPA/opa.exe"'
        TF_EXE      = '"C:/Program Files/terraform/terraform.exe"'
        CHECKOV_EXE = 'checkov'
        ENVIRONMENT = 'dev'
    }

    stages {

        // -------------------------------------------------------------------
        // SCENARIO 1 – Entry point. Every build starts here.
        // Clean the outputs/ folder so stale artifacts from a previous run
        // cannot influence this build.
        // -------------------------------------------------------------------
        stage('Checkout Code') {
            steps {
                checkout scm
                bat '''
                if not exist outputs mkdir outputs
                del /f /q outputs\\*.json 2>nul
                del /f /q outputs\\*.log  2>nul
                echo [Init] Workspace ready.
                '''
            }
        }

        // -------------------------------------------------------------------
        // Initialise Terraform providers and validate HCL syntax before any
        // scanning or planning takes place.
        // -------------------------------------------------------------------
        stage('Terraform Init & Validate') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    dir('terraform') {
                        bat "${env.TF_EXE} init -upgrade -input=false"
                        bat "${env.TF_EXE} validate"
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 2 – IaC Static Analysis.
        // tfsec then Checkov run sequentially. Both write JSON to outputs/.
        // Neither fails the build directly.
        // -------------------------------------------------------------------
        stage('Layer A: Static Analysis (Checkov / tfsec)') {
            steps {
                bat(returnStatus: true,
                    script: "${env.TFSEC_EXE} terraform --format json --include-passed 1>outputs/tfsec_results.json 2>outputs/tfsec_error.log")
                bat(returnStatus: true,
                    script: "${env.CHECKOV_EXE} -d terraform --output json --output-file outputs/checkov_results.json --soft-fail 2>outputs/checkov_error.log")
            }
        }

        // -------------------------------------------------------------------
        // Generate Terraform plan. Used as input for OPA checks below.
        // Wrapped in catchError so OPA can still run and report even if
        // Terraform cannot connect (e.g., no Azure credentials in CI).
        // -------------------------------------------------------------------
        stage('Terraform Plan generation') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    script {
                        writeFile file: 'outputs/env_config.json',
                                  text: groovy.json.JsonOutput.toJson([
                                      config: [environment: env.ENVIRONMENT]
                                  ])
                    }
                    dir('terraform') {
                        bat "${env.TF_EXE} plan -out=tfplan -input=false"
                        bat "${env.TF_EXE} show -json tfplan > ../outputs/tfplan.json"
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 3/4 – OPA Policy Validation (parallel).
        // CIS Azure Benchmark has moved to the remediative pipeline where it
        // runs against live infrastructure via tfsec + OPA.
        // VM Size and Mandatory Tags remain here as pre-deployment IaC gates.
        // Each check writes its own JSON result file to outputs/.
        // -------------------------------------------------------------------
        stage('Layer B: OPA Policy Validation') {
            parallel {

                // Scenario 3 — VM size cost control
                stage('VM Size Policy') {
                    steps {
                        script {
                            if (!fileExists('outputs/tfplan.json')) {
                                echo "Skipping VM Size Policy — outputs/tfplan.json unavailable."
                                writeFile file: 'outputs/opa_vm_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                    groovy.json.JsonOutput.toJson([
                                        check : 'VM Size Policy',
                                        policy: 'policies/vm_size.rego',
                                        status: 'SKIPPED',
                                        reason: 'outputs/tfplan.json not produced (Terraform Plan failed)'
                                    ])
                                )
                                return
                            }
                            def result = bat(
                                script: """@echo off
${env.OPA_EXE} eval -i outputs/tfplan.json -d policies/vm_size.rego -d outputs/env_config.json "data.policy.vm_size.deny" --format pretty""",
                                returnStdout: true
                            ).trim()
                            echo "--- VM Size Policy ---\n${result}"
                            def hasViolation = result.contains('VIOLATION')
                            def violationLines = result.split('\n').findAll { it.trim().contains('VIOLATION') }
                            writeFile file: 'outputs/opa_vm_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson([
                                    check      : 'VM Size Policy',
                                    policy     : 'policies/vm_size.rego',
                                    status     : hasViolation ? 'FAILED' : 'PASSED',
                                    violations : violationLines,
                                    raw_output : result
                                ])
                            )
                            if (hasViolation) {
                                unstable("OPA: VM Size Policy check failed — see outputs/opa_vm_result.json")
                            }
                        }
                    }
                }

                // Scenario 4 — Mandatory resource tags governance
                stage('Mandatory Tags') {
                    steps {
                        script {
                            if (!fileExists('outputs/tfplan.json')) {
                                echo "Skipping Mandatory Tags — outputs/tfplan.json unavailable."
                                writeFile file: 'outputs/opa_tags_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                    groovy.json.JsonOutput.toJson([
                                        check : 'Mandatory Tags',
                                        policy: 'policies/tags.rego',
                                        status: 'SKIPPED',
                                        reason: 'outputs/tfplan.json not produced (Terraform Plan failed)'
                                    ])
                                )
                                return
                            }
                            def result = bat(
                                script: """@echo off
${env.OPA_EXE} eval -i outputs/tfplan.json -d policies/tags.rego "data.policy.tags.deny" --format pretty""",
                                returnStdout: true
                            ).trim()
                            echo "--- Mandatory Tags ---\n${result}"
                            def hasViolation = result.contains('VIOLATION')
                            def violationLines = result.split('\n').findAll { it.trim().contains('VIOLATION') }
                            writeFile file: 'outputs/opa_tags_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson([
                                    check      : 'Mandatory Tags',
                                    policy     : 'policies/tags.rego',
                                    status     : hasViolation ? 'FAILED' : 'PASSED',
                                    violations : violationLines,
                                    raw_output : result
                                ])
                            )
                            if (hasViolation) {
                                unstable("OPA: Mandatory Tags check failed — see outputs/opa_tags_result.json")
                            }
                        }
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 1 – Terraform Apply.
        // Only runs when every prior stage passed (build result == SUCCESS).
        // Any unstable() call above will cause this stage to be skipped,
        // ensuring no infrastructure is changed when violations exist.
        // -------------------------------------------------------------------
        stage('Terraform Apply (Deploy)') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                dir('terraform') {
                    bat "${env.TF_EXE} apply -auto-approve -input=false tfplan"
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'outputs/**', allowEmptyArchive: true
        }
        success {
            echo "Pipeline complete — infrastructure deployed and fully compliant."
        }
        unstable {
            echo "Pipeline unstable — security violations found. Infrastructure was NOT changed. Review outputs/opa_*_result.json artifacts."
        }
        failure {
            echo "Pipeline failed — no infrastructure was changed. Review the failing stage above."
        }
    }
}
