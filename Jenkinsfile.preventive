pipeline {
    agent any

    environment {
        TFSEC_EXE         = '"C:/Program Files/tfsec/tfsec.exe"'
        OPA_EXE           = '"C:/Program Files/OPA/opa.exe"'
        TF_EXE            = '"C:/Program Files/terraform/terraform.exe"'
        CHECKOV_EXE       = 'checkov'
        TEAMS_WEBHOOK_URL = credentials('TEAMS_WEBHOOK_URL')
        ENVIRONMENT       = 'dev'
    }

    stages {

        // -------------------------------------------------------------------
        // SCENARIO 1 – Entry point. Every build starts here.
        // -------------------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 2 – IaC Static Analysis.
        // tfsec and Checkov run in parallel. Both write JSON that feeds the
        // next stage. Neither fails the build directly.
        // -------------------------------------------------------------------
        stage('IaC Static Analysis') {
            parallel {

                stage('tfsec') {
                    steps {
                        bat "${env.TFSEC_EXE} terraform --format json --include-passed > tfsec_results.json"
                    }
                }

                stage('Checkov') {
                    steps {
                        bat(returnStatus: true,
                            script: "${env.CHECKOV_EXE} -d terraform --output json --soft-fail > checkov_results.json 2>checkov_error.log")
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 2 – Triage findings.
        // CRITICAL/HIGH  → blocking → build marked UNSTABLE (not FAILURE),
        //                  pipeline continues so all checks still run.
        // MEDIUM/LOW     → advisory → captured in warnings.txt.
        // All findings persisted to findings.json for archiving.
        // -------------------------------------------------------------------
        stage('Evaluate Security Findings') {
            steps {
                script {
                    def exitCode = bat(returnStatus: true, script: 'python parse_findings.py')
                    def warningText = readFile('warnings.txt').trim()
                    env.HAS_WARNINGS = (warningText.length() > 0).toString()

                    if (exitCode != 0) {
                        def blockingText = readFile('blocking.txt').trim()
                        echo "BLOCKING VIOLATIONS:\n${blockingText}"
                        unstable("Static analysis: blocking violation(s) found — see findings.json")
                    } else {
                        def warnCount = warningText ? warningText.split('\n').length : 0
                        echo "Static analysis passed. ${warnCount} advisory finding(s)."
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // Generate Terraform plan. Used as input for OPA checks below.
        // Wrapped in catchError so OPA can still run and report even if
        // Terraform cannot connect (e.g., no Azure credentials in CI).
        // -------------------------------------------------------------------
        stage('Terraform Plan') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    script {
                        writeFile file: 'env_config.json',
                                  text: groovy.json.JsonOutput.toJson([
                                      config: [environment: env.ENVIRONMENT]
                                  ])
                    }
                    dir('terraform') {
                        bat "${env.TF_EXE} init -upgrade -input=false"
                        bat "${env.TF_EXE} plan -out=tfplan -input=false"
                        bat "${env.TF_EXE} show -json tfplan > ../tfplan.json"
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 2/3/4 – OPA Policy Checks (parallel).
        // Each check writes its own JSON result file.
        // Violations mark the build UNSTABLE (not FAILURE) so all three
        // checks always complete and the archive stage always runs.
        // -------------------------------------------------------------------
        stage('OPA Policy Checks') {
            parallel {

                // Scenario 2 — CIS Azure Benchmark re-check on tfsec output
                stage('CIS Compliance') {
                    steps {
                        script {
                            def result = bat(
                                script: """@echo off
${env.OPA_EXE} eval -i tfsec_results.json -d policies/cis_azure.rego "data.cis.azure.deny" --format pretty""",
                                returnStdout: true
                            ).trim()
                            echo "--- CIS Compliance ---\n${result}"
                            def hasViolation = result.contains('VIOLATION')
                            def violationLines = result.split('\n').findAll { it.trim().contains('VIOLATION') }
                            writeFile file: 'opa_cis_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson([
                                    check      : 'CIS Compliance',
                                    policy     : 'policies/cis_azure.rego',
                                    status     : hasViolation ? 'FAILED' : 'PASSED',
                                    violations : violationLines,
                                    raw_output : result
                                ])
                            )
                            if (hasViolation) {
                                unstable("OPA: CIS Compliance check failed — see opa_cis_result.json")
                            }
                        }
                    }
                }

                // Scenario 3 — VM size cost control
                stage('VM Size Policy') {
                    steps {
                        script {
                            if (!fileExists('tfplan.json')) {
                                echo "Skipping VM Size Policy — tfplan.json unavailable."
                                writeFile file: 'opa_vm_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                    groovy.json.JsonOutput.toJson([
                                        check : 'VM Size Policy',
                                        policy: 'policies/vm_size.rego',
                                        status: 'SKIPPED',
                                        reason: 'tfplan.json not produced (Terraform Plan failed)'
                                    ])
                                )
                                return
                            }
                            def result = bat(
                                script: """@echo off
${env.OPA_EXE} eval -i tfplan.json -d policies/vm_size.rego -d env_config.json "data.policy.vm_size.deny" --format pretty""",
                                returnStdout: true
                            ).trim()
                            echo "--- VM Size Policy ---\n${result}"
                            def hasViolation = result.contains('VIOLATION')
                            def violationLines = result.split('\n').findAll { it.trim().contains('VIOLATION') }
                            writeFile file: 'opa_vm_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson([
                                    check      : 'VM Size Policy',
                                    policy     : 'policies/vm_size.rego',
                                    status     : hasViolation ? 'FAILED' : 'PASSED',
                                    violations : violationLines,
                                    raw_output : result
                                ])
                            )
                            if (hasViolation) {
                                unstable("OPA: VM Size Policy check failed — see opa_vm_result.json")
                            }
                        }
                    }
                }

                // Scenario 4 — Mandatory resource tags governance
                stage('Mandatory Tags') {
                    steps {
                        script {
                            if (!fileExists('tfplan.json')) {
                                echo "Skipping Mandatory Tags — tfplan.json unavailable."
                                writeFile file: 'opa_tags_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                    groovy.json.JsonOutput.toJson([
                                        check : 'Mandatory Tags',
                                        policy: 'policies/tags.rego',
                                        status: 'SKIPPED',
                                        reason: 'tfplan.json not produced (Terraform Plan failed)'
                                    ])
                                )
                                return
                            }
                            def result = bat(
                                script: """@echo off
${env.OPA_EXE} eval -i tfplan.json -d policies/tags.rego "data.policy.tags.deny" --format pretty""",
                                returnStdout: true
                            ).trim()
                            echo "--- Mandatory Tags ---\n${result}"
                            def hasViolation = result.contains('VIOLATION')
                            def violationLines = result.split('\n').findAll { it.trim().contains('VIOLATION') }
                            writeFile file: 'opa_tags_result.json', text: groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson([
                                    check      : 'Mandatory Tags',
                                    policy     : 'policies/tags.rego',
                                    status     : hasViolation ? 'FAILED' : 'PASSED',
                                    violations : violationLines,
                                    raw_output : result
                                ])
                            )
                            if (hasViolation) {
                                unstable("OPA: Mandatory Tags check failed — see opa_tags_result.json")
                            }
                        }
                    }
                }
            }
        }

        // -------------------------------------------------------------------
        // Consolidate all tool outputs into a single human-readable report.
        // security_report.json has one row per check with:
        //   tool | check_id | severity | input | status | reason
        // -------------------------------------------------------------------
        stage('Generate Security Report') {
            steps {
                bat(returnStatus: true, script: 'python generate_report.py')
            }
        }

        // -------------------------------------------------------------------
        // Archive every JSON artifact so they appear on the Jenkins build
        // page regardless of build outcome.
        // -------------------------------------------------------------------
        stage('Archive Security Report') {
            steps {
                archiveArtifacts artifacts: 'security_report.json, findings.json, tfsec_results.json, checkov_results.json, opa_cis_result.json, opa_vm_result.json, opa_tags_result.json',
                                 allowEmptyArchive: true
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 1 – Terraform Apply.
        // Only runs when every prior stage passed (build result == SUCCESS).
        // Any unstable() call above will cause this stage to be skipped,
        // ensuring no infrastructure is changed when violations exist.
        // -------------------------------------------------------------------
        stage('Terraform Apply') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                dir('terraform') {
                    bat "${env.TF_EXE} apply -auto-approve -input=false tfplan"
                }
            }
        }

        // -------------------------------------------------------------------
        // SCENARIO 5 – Teams notification.
        // Always runs. Color-codes the card by build result:
        //   GREEN   = all checks passed, infrastructure deployed
        //   ORANGE  = violations found, infrastructure NOT changed
        //   RED     = pipeline error (Terraform or tool failure)
        // -------------------------------------------------------------------
        stage('Notify Teams') {
            steps {
                script {
                    def buildResult  = currentBuild.currentResult
                    def blockingText = fileExists('blocking.txt') ? readFile('blocking.txt').trim() : ''
                    def warningText  = fileExists('warnings.txt') ? readFile('warnings.txt').trim() : ''

                    def themeColor  = (buildResult == 'SUCCESS')  ? '00CC44' :
                                      (buildResult == 'UNSTABLE') ? 'FFA500' : 'CC0000'
                    def statusLabel = (buildResult == 'SUCCESS')  ? 'PASSED — infrastructure deployed' :
                                      (buildResult == 'UNSTABLE') ? 'UNSTABLE — violations found, no changes applied' :
                                                                    'FAILED — review pipeline logs'

                    def bodyParts = []
                    if (blockingText) {
                        bodyParts << '<b>Blocking Violations (CRITICAL/HIGH):</b><br>' + blockingText.replace('\n', '<br>')
                    }
                    if (warningText) {
                        bodyParts << '<b>Advisory Warnings (MEDIUM/LOW):</b><br>' + warningText.replace('\n', '<br>')
                    }
                    if (!bodyParts) {
                        bodyParts << 'All security checks passed. No findings.'
                    }

                    def payload = groovy.json.JsonOutput.toJson([
                        "@type"     : "MessageCard",
                        "@context"  : "http://schema.org/extensions",
                        "themeColor": themeColor,
                        "summary"   : "${statusLabel} — ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        "sections"  : [[
                            "activityTitle"   : "${statusLabel}",
                            "activitySubtitle": "${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            "activityText"    : bodyParts.join('<br><br>'),
                            "markdown"        : true
                        ]]
                    ])
                    writeFile file: 'teams_payload.json', text: payload
                    bat(returnStatus: true,
                        script: 'curl -s -X POST -H "Content-Type: application/json" -d @teams_payload.json %TEAMS_WEBHOOK_URL%')
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline complete — infrastructure deployed and fully compliant."
        }
        unstable {
            echo "Pipeline unstable — security violations found. Infrastructure was NOT changed. Review findings.json and opa_*_result.json artifacts."
        }
        failure {
            echo "Pipeline failed — no infrastructure was changed. Review the failing stage above."
        }
    }
}
